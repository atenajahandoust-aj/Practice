<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">
    <persistence-unit name="ir.maktabsharif">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>ir.maktabsharif.digitallibrary.model.Member</class>
        <class>ir.maktabsharif.digitallibrary.model.Manuscript</class>
        <class>ir.maktabsharif.digitallibrary.model.Magazine</class>
        <class>ir.maktabsharif.digitallibrary.model.LibraryItems</class>
        <class>ir.maktabsharif.digitallibrary.model.Loan</class>
        <class>ir.maktabsharif.digitallibrary.model.Book</class>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/digital_library"/>
            <property name="jakarta.persistence.jdbc.user" value="postgres"/>
            <property name="jakarta.persistence.jdbc.password" value="Atena1381"/>
            <property name="hibernate.hbm2ddl.auto" value="create"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>

    </persistence-unit>
</persistence>
